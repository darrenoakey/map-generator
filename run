#!/bin/bash
# Run script for map-generator
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$DIR/.venv"

if [ ! -d "$VENV" ]; then
    echo "Setting up virtual environment..."
    python3.12 -m venv "$VENV"
    "$VENV/bin/pip" install -q -e "$DIR[dev]"
fi

case "${1:-serve}" in
  check)
    exec "$VENV/bin/python" -m pytest -W error
    ;;
  deploy)
    exec "$VENV/bin/python" -m pytest -W error
    ;;
  serve|run)
    shift || true
    exec "$VENV/bin/map-generator" "$@"
    ;;
  *)
    exec "$VENV/bin/map-generator" "$@"
    ;;
esac
